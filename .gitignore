temp/
tmp/
*.tmp
*.temp
*.swp
*~
logs/
*.log

# ── Graphics (large — allow exceptions above) ─────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.tiff
*.bmp
*.pdf
*.ps
*.svg
*.eps

# ── System files ──────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
Thumbs.db
$RECYCLE.BIN/

# ── IDE files ─────────────────────────────────────────────────────────────────
